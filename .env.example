# Copy this file to ".env" and fill it in. ".env" must never be committed.

# GoLogin API token: app.gologin.com -> Settings -> API -> create a token.
GOLOGIN_TOKEN=

# The profile the browser runs as. Find IDs with:
#   python run.py --list-profiles
# Several ids, comma-separated, are allowed -- with --workers N you need at
# least N of them, because GoLogin will not run one profile in two browsers.
GOLOGIN_PROFILE_ID=

# Optional: a specific chromedriver binary. Leave blank to match one to the
# Chrome version Orbita reports.
CHROMEDRIVER_PATH=

# Optional: Chrome extensions to load into the browser on every run. The easy
# way needs nothing here: drop the extension into the extensions/ folder (see
# extensions/README.txt). This is for one kept somewhere else -- give the
# unpacked extension's folder -- the one holding manifest.json -- and separate
# several with commas. Relative paths start at this project folder, e.g.
#   EXTENSION_DIRS=extensions/my-extension
# GoLogin and the local backends only. --extension PATH adds one for one run.
EXTENSION_DIRS=

# Optional: your CapSolver API key (dashboard.capsolver.com, starts "CAP-").
# Filled into the CapSolver extension before every launch, so each browser
# starts with it already set -- nothing to paste into the popup. The key only
# goes into the copy under extensions/.unpacked/, never a file git tracks.
CAPSOLVER_API_KEY=

# --- Browserless (only for --backend browserless) --------------------------

# Token from the dashboard at browserless.io. BROWSERLESS_API is accepted as
# an alias. Paste the token itself -- if it arrives wrapped in <angle
# brackets> or quotes, those are stripped for you.
BROWSERLESS_TOKEN=

# Leave blank for the shared cloud (production-sfo.browserless.io). A
# dedicated plan has its own host, and its token is refused by the shared
# cloud -- which reads as a bad token when the token is fine. A dedicated or
# self-hosted deployment also raises the 120s session cap that the shared
# plan imposes, which is shorter than one lead takes.
BROWSERLESS_HOST=
